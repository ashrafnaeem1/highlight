{
  "manifest_version": 3,
  "name": "highlight",
  "version": "0.0.6",
  "description": "Highlight and annotate selected text on any page.",
  "icons": {
    "96": "icons/highlighter-96.png"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/*.svg"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "96": "icons/highlighter-96.png"
    }
  }
}
