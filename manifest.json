{
  "manifest_version": 3,
  "name": "Ash Highlight",
  "version": "0.1.1",
  "description": "Highlight and annotate selected text on any page.",
  "icons": {
    "16": "icons/highlighter-16.png",
    "32": "icons/highlighter-32.png",
    "48": "icons/highlighter-48.png",
    "128": "icons/highlighter-128.png"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/*.svg"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/highlighter-16.png",
      "32": "icons/highlighter-32.png"
    }
  }
}
